# Reader of tools/s32ds_sources.txt for CMake (NETWORK_BUILD_RTD_MOCK); the
# same rules as tools/source_list.py, which the Python tools use:
#   <path relative to firmware/network>   [@NODE ...]      NODE: VSS CIS BCM DOMAIN
# - a .c line without a tag belongs to every node; a tagged .c line only to
#   the nodes it names
# - a .h line must carry tags (a node-only header); headers are never compiled
#   here, only checked to exist
# - a file in nodes/<node>/ carries exactly that node's tag, a file with one
#   tag lives in nodes/<node>/, and no two lines have the same logical path
#   (the path without nodes/<node>/)
# - an unknown or repeated tag, a header line without a tag, a path that is not
#   a relative .c/.h path, a path listed twice or a missing file stops the
#   configure step (FATAL_ERROR)
# - the characters ; [ ] are not allowed anywhere in the file (they would change
#   how CMake splits its lines into a list)
#
# network_read_source_list(<list file> <root> <node> <out selected> <out common>)
#   <out selected>: the .c files of <node> (untagged + tagged with it), list order
#   <out common>  : the untagged .c files, list order
function(network_read_source_list list_file root node out_selected out_common)
    set(_known VSS CIS BCM DOMAIN)
    file(READ "${list_file}" _raw)
    string(FIND "${_raw}" ";" _semicolon_at)
    string(FIND "${_raw}" "[" _open_at)
    string(FIND "${_raw}" "]" _close_at)
    if(_semicolon_at GREATER_EQUAL 0 OR _open_at GREATER_EQUAL 0 OR _close_at GREATER_EQUAL 0)
        message(FATAL_ERROR "tools/s32ds_sources.txt (${list_file}):\n  the characters ; [ ] are not allowed (also not in comments)")
    endif()
    file(STRINGS "${list_file}" _lines)
    set(_problems)
    set(_seen)
    set(_seen_logical)
    set(_selected)
    set(_common)
    foreach(_line IN LISTS _lines)
        string(REGEX REPLACE "#.*$" "" _line "${_line}")
        string(STRIP "${_line}" _line)
        if(_line STREQUAL "")
            continue()
        endif()
        string(REGEX MATCHALL "[^ \t\r]+" _tokens "${_line}")
        list(POP_FRONT _tokens _path)
        if(_path MATCHES "^@")
            list(APPEND _problems "node tag without a path: ${_line}")
            continue()
        endif()
        if(NOT _path MATCHES "^[A-Za-z0-9_][A-Za-z0-9_./-]*\\.[ch]$" OR _path MATCHES "//"
           OR _path MATCHES "(^|/)\\.\\.?(/|$)")
            list(APPEND _problems "'${_path}' is not a .c/.h path relative to firmware/network")
            continue()
        endif()
        set(_tags)
        set(_bad FALSE)
        foreach(_tag IN LISTS _tokens)
            string(REGEX REPLACE "^@" "" _name "${_tag}")
            list(FIND _known "${_name}" _known_at)
            if(NOT _tag MATCHES "^@" OR _known_at LESS 0)
                list(APPEND _problems "unknown node tag '${_tag}' on ${_path} (tags: @VSS @CIS @BCM @DOMAIN)")
                set(_bad TRUE)
            else()
                list(FIND _tags "${_name}" _repeat_at)
                if(_repeat_at GREATER_EQUAL 0)
                    list(APPEND _problems "node tag ${_tag} repeated on ${_path}")
                    set(_bad TRUE)
                endif()
                list(APPEND _tags "${_name}")
            endif()
        endforeach()
        if(_bad)
            continue()
        endif()
        list(LENGTH _tags _tag_count)
        if(_path MATCHES "\\.h$" AND _tag_count EQUAL 0)
            list(APPEND _problems "header line ${_path} has no node tag (list only node-only headers)")
            continue()
        endif()
        list(FIND _seen "${_path}" _seen_at)
        if(_seen_at GREATER_EQUAL 0)
            list(APPEND _problems "${_path} is listed twice")
            continue()
        endif()
        list(APPEND _seen "${_path}")
        if(_path MATCHES "^nodes/")
            set(_home "")
            if(_path MATCHES "^nodes/([a-z]+)/")
                string(TOUPPER "${CMAKE_MATCH_1}" _home)
            endif()
            list(FIND _known "${_home}" _home_at)
            if(_home STREQUAL "" OR _home_at LESS 0)
                list(APPEND _problems "${_path} is in nodes/ but not in a node folder (nodes/vss/ nodes/cis/ nodes/bcm/ nodes/domain/)")
                continue()
            endif()
            if(NOT "${_tags}" STREQUAL "${_home}")
                list(APPEND _problems "${_path} is in a node folder and must carry exactly the tag @${_home}")
                continue()
            endif()
        elseif(_tag_count EQUAL 1)
            string(TOLOWER "${_tags}" _lower)
            list(APPEND _problems "${_path} belongs to one node and must be in nodes/${_lower}/${_path}")
            continue()
        endif()
        set(_logical "${_path}")
        if(_path MATCHES "^nodes/[a-z]+/(.*)$")
            set(_logical "${CMAKE_MATCH_1}")
        endif()
        list(FIND _seen_logical "${_logical}" _logical_at)
        if(_logical_at GREATER_EQUAL 0)
            list(APPEND _problems "${_path} has the same logical path as another line (${_logical})")
            continue()
        endif()
        list(APPEND _seen_logical "${_logical}")
        if(NOT EXISTS "${root}/${_path}")
            list(APPEND _problems "lists a missing file: ${_path}")
            continue()
        endif()
        if(_path MATCHES "\\.c$")
            if(_tag_count EQUAL 0)
                list(APPEND _common "${_path}")
                list(APPEND _selected "${_path}")
            else()
                list(FIND _tags "${node}" _node_at)
                if(_node_at GREATER_EQUAL 0)
                    list(APPEND _selected "${_path}")
                endif()
            endif()
        endif()
    endforeach()
    if(_problems)
        list(JOIN _problems "\n  " _message)
        message(FATAL_ERROR "tools/s32ds_sources.txt (${list_file}):\n  ${_message}")
    endif()
    set(${out_selected} ${_selected} PARENT_SCOPE)
    set(${out_common} ${_common} PARENT_SCOPE)
endfunction()

+                NET_BOARD_CAN_INSTANCE, (uint8_t)(TX_FIRST + i));
+            if (!rollback_flexcan_step(NET_HAL_RTD_ROLLBACK_CAN_ABORT_TX, st, true)) ok = false;
+        }
+    }
+    if (can.controller_started) {
+        Flexcan_Ip_StatusType st = FlexCAN_Ip_SetStopMode(NET_BOARD_CAN_INSTANCE);
+        if (!rollback_flexcan_step(NET_HAL_RTD_ROLLBACK_CAN_STOP, st, false)) ok = false;
+        else can.controller_started = false;
+    }
+    {
+        Flexcan_Ip_StatusType st = FlexCAN_Ip_Deinit(NET_BOARD_CAN_INSTANCE);
+        if (!rollback_flexcan_step(NET_HAL_RTD_ROLLBACK_CAN_DEINIT, st, false)) ok = false;
+        else {
+            can.initialized = false;
+            can.controller_started = false;
+            can.rx_configured = 0u;
+            can.rx_armed = 0u;
+        }
+    }
+    return ok;
 }
 

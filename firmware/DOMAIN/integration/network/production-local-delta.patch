+bool net_hal_rtd_owner_claim(NetHalRtdOwner owner)
+{
+    bool claimed = false;
+    uint32_t key;
+    if (owner != NET_HAL_RTD_OWNER_PRODUCTION && owner != NET_HAL_RTD_OWNER_UART_DIAGNOSTIC)
+        return false;
+    key = net_board_irq_save();
+    if (hal_owner == NET_HAL_RTD_OWNER_NONE) { hal_owner = owner; claimed = true; }
+    net_board_irq_restore(key);
+    return claimed;
+}
+
+bool net_hal_rtd_owner_release(NetHalRtdOwner owner, bool cleanup_succeeded)
+{
+    bool released = false;
+    uint32_t key = net_board_irq_save();
+    if (hal_owner == owner) {
+        if (cleanup_succeeded) { hal_owner = NET_HAL_RTD_OWNER_NONE; released = true; }
+        else hal_owner = NET_HAL_RTD_OWNER_UNCERTAIN;
+    }
+    net_board_irq_restore(key);
+    return released;
+}
